-- Database Management System: Library Management

-- Create Database
CREATE DATABASE IF NOT EXISTS library_management;

-- Use Database
USE library_management;

-- ---------------------------------------------------------------------------------------------------
--  TABLE: Authors
--  Stores information about authors of books.
-- ---------------------------------------------------------------------------------------------------
1.
CREATE TABLE Authors (
    AuthorID INT PRIMARY KEY AUTO_INCREMENT,
    FirstName VARCHAR(255) NOT NULL,
    LastName VARCHAR(255) NOT NULL,
    Biography TEXT,
    DateOfBirth DATE
);

-- ---------------------------------------------------------------------------------------------------
--  TABLE: Publishers
--  Stores information about book publishers.
-- ---------------------------------------------------------------------------------------------------

CREATE TABLE Publishers (
    PublisherID INT PRIMARY KEY AUTO_INCREMENT,
    PublisherName VARCHAR(255) NOT NULL,
    Address VARCHAR(255),
    ContactNumber VARCHAR(20)
);

-- ---------------------------------------------------------------------------------------------------
--  TABLE: Categories
--  Stores categories of books (e.g., Fiction, Science, History).
-- ---------------------------------------------------------------------------------------------------

CREATE TABLE Categories (
    CategoryID INT PRIMARY KEY AUTO_INCREMENT,
    CategoryName VARCHAR(255) NOT NULL UNIQUE
);

-- ---------------------------------------------------------------------------------------------------
--  TABLE: Books
--  Stores information about books.
-- ---------------------------------------------------------------------------------------------------

CREATE TABLE Books (
    BookID INT PRIMARY KEY AUTO_INCREMENT,
    Title VARCHAR(255) NOT NULL,
    AuthorID INT NOT NULL,
    PublisherID INT NOT NULL,
    CategoryID INT NOT NULL,
    ISBN VARCHAR(20) UNIQUE NOT NULL,
    PublicationYear INT,
    PageCount INT,
    Description TEXT,
    FOREIGN KEY (AuthorID) REFERENCES Authors(AuthorID),
    FOREIGN KEY (PublisherID) REFERENCES Publishers(PublisherID),
    FOREIGN KEY (CategoryID) REFERENCES Categories(CategoryID)
);

-- ---------------------------------------------------------------------------------------------------
--  TABLE: Members
--  Stores information about library members.
-- ---------------------------------------------------------------------------------------------------

CREATE TABLE Members (
    MemberID INT PRIMARY KEY AUTO_INCREMENT,
    FirstName VARCHAR(255) NOT NULL,
    LastName VARCHAR(255) NOT NULL,
    Address VARCHAR(255),
    PhoneNumber VARCHAR(20),
    Email VARCHAR(255) UNIQUE,
    DateOfBirth DATE,
    JoinDate DATE NOT NULL
);

-- ---------------------------------------------------------------------------------------------------
--  TABLE: Loans
--  Tracks book loans to members.
-- ---------------------------------------------------------------------------------------------------

CREATE TABLE Loans (
    LoanID INT PRIMARY KEY AUTO_INCREMENT,
    BookID INT NOT NULL,
    MemberID INT NOT NULL,
    LoanDate DATE NOT NULL,
    DueDate DATE NOT NULL,
    ReturnDate DATE,  -- Can be NULL if the book is not returned yet
    FOREIGN KEY (BookID) REFERENCES Books(BookID),
    FOREIGN KEY (MemberID) REFERENCES Members(MemberID)
);

-- ---------------------------------------------------------------------------------------------------
--  TABLE: Fines
--  Stores information about fines incurred by members for late returns.
-- ---------------------------------------------------------------------------------------------------

CREATE TABLE Fines (
    FineID INT PRIMARY KEY AUTO_INCREMENT,
    LoanID INT NOT NULL,
    FineAmount DECIMAL(10, 2) NOT NULL,
    PaymentDate DATE, -- Can be NULL if the fine is not paid yet
    FOREIGN KEY (LoanID) REFERENCES Loans(LoanID)
);


