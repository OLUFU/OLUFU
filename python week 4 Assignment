
1.def modify_file(input_filename, output_filename, modification_function):
    """
    Reads an input file, applies a modification to each line,
    and writes the modified lines to a new output file.

    Args:
        input_filename (str): The name of the input file to read.
        output_filename (str): The name of the output file to write.
        modification_function (function): A function that takes a string (a line
            from the input file) as input and returns a modified string.
    """

    try:
        with open(input_filename, 'r') as infile, open(output_filename, 'w') as outfile:
            for line in infile:
                modified_line = modification_function(line)
                outfile.write(modified_line)

        print(f"File '{input_filename}' processed and written to '{output_filename}' successfully.")

    except FileNotFoundError:
        print(f"Error: Input file '{input_filename}' not found.")
    except Exception as e:
        print(f"An error occurred: {e}")


# Example Modification Functions:
def uppercase_line(line):
    """Converts a line to uppercase."""
    return line.upper()

def add_line_number(line, line_number):
    """Adds a line number to the beginning of each line."""
    return f"{line_number}: {line}"  # Preserve original line breaks and content

def remove_whitespace(line):
    """Removes leading and trailing whitespace from a line."""
    return line.strip() + '\n' # Adds a newline character to ensure correct formatting

def replace_word(line, old_word, new_word):
    """Replaces all occurrences of a word in a line."""
    return line.replace(old_word, new_word)

def reverse_words(line):
    """Reverses the order of words in a line."""
    words = line.split()
    reversed_words = words[::-1]
    return " ".join(reversed_words) + '\n'


if __name__ == "__main__":
